CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y

CONFIG_USB_DEVICE_STACK=y
CONFIG_USB_DEVICE_MANUFACTURER="Mocha-Elec"
CONFIG_USB_DEVICE_PRODUCT="Mochi"

CONFIG_BATTERY_USE_REG_BUCK_MAPPING=y
CONFIG_LED_RGB_COLOR=y
CONFIG_SENSOR_ROTATION_0=y

#generate for adafruit uf2 bootloader flashing
CONFIG_BUILD_OUTPUT_UF2=y
CONFIG_FLASH_LOAD_OFFSET=0x1000

# Mochi has no external 32.768 kHz crystal on XL1/XL2; an external source
# makes LFCLK fail to start and the IMU is never detected.
# Synthesize LFCLK from HFCLK (higher power, but TDMA-safe).
CONFIG_CLOCK_SOURCE_LFCLK_SYNTH=y
